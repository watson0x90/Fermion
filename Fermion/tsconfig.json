{
  "//": "Type-checking only (no build). JS modules opt in with `// @ts-check`; the React app (src/ui, .ts/.tsx) is fully checked. Run: npx tsc -p tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.tsx", "src/globals.d.ts"],
  "exclude": ["node_modules", "src/frameworks", "src/lang", "src/tools", "out", "src/renderer.bundle.js"]
}
